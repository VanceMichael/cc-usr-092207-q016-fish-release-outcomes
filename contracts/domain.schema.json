{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "珍稀鱼类放流成效核验共享资料",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "actors",
    "facts",
    "constraints",
    "custody_chain",
    "reaches",
    "batches",
    "releases",
    "observations",
    "origin_assignments",
    "analyses",
    "decisions"
  ],
  "properties": {
    "domain": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 2},
    "sample_id": {"type": "string", "minLength": 1},
    "program": {
      "type": "object",
      "required": ["species", "cumulative_released", "cumulative_unit"],
      "properties": {
        "species": {"type": "string", "minLength": 1},
        "cumulative_released": {"type": "integer", "minimum": 0},
        "cumulative_unit": {"type": "string"},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "actors": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "name", "responsibilities"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "responsibilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "broodstock",
                "breeding_quarantine",
                "tagging",
                "hatchery_evidence",
                "transport",
                "on_site_count",
                "release_execution",
                "field_sampling",
                "resighting",
                "independent_evidence",
                "origin_assignment",
                "survival_dispersal_analysis",
                "recomputation",
                "annual_decision"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "facts": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "constraints": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "reaches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {"id": {"type": "string"}, "name": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "custody_chain": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["stage", "actor", "description"],
        "properties": {
          "stage": {
            "enum": [
              "broodstock",
              "breeding_quarantine",
              "tagging",
              "transport",
              "on_site_count",
              "release",
              "post_release_sampling"
            ]
          },
          "actor": {"type": "string", "minLength": 1},
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "broodstock": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "species", "source", "genetic_sample_id"],
        "properties": {
          "id": {"type": "string"},
          "species": {"type": "string"},
          "source": {"type": "string"},
          "genetic_sample_id": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "species", "parent_ids", "quarantine_passed", "genetic_reference", "tag_methods"],
        "properties": {
          "id": {"type": "string"},
          "species": {"type": "string"},
          "spawn_date": {"type": "string"},
          "parent_ids": {"type": "array", "items": {"type": "string"}},
          "quarantine_passed": {"type": "boolean"},
          "genetic_reference": {"type": "string"},
          "tag_methods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["method", "coverage"],
              "properties": {
                "method": {"type": "string"},
                "coverage": {"type": "number", "minimum": 0, "maximum": 1},
                "expected_shed_rate": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "transport_containers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "batch_id", "seal_id", "loaded_count"],
        "properties": {
          "id": {"type": "string"},
          "batch_id": {"type": "string"},
          "seal_id": {"type": "string"},
          "loaded_count": {"type": "integer", "minimum": 0},
          "doa_on_arrival": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "batch_id", "reach_id", "date", "declared_count"],
        "properties": {
          "id": {"type": "string"},
          "batch_id": {"type": "string"},
          "container_ids": {"type": "array", "items": {"type": "string"}},
          "reach_id": {"type": "string"},
          "date": {"type": "string"},
          "declared_count": {"type": "integer", "minimum": 0},
          "hydrology": {
            "type": "object",
            "properties": {
              "discharge_m3s": {"type": "number"},
              "water_temp_c": {"type": "number"},
              "turbidity_ntu": {"type": "number"},
              "source_observation_ids": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "type", "actor", "observed_at", "payload", "immutable", "recorded_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {
            "enum": [
              "hydrology",
              "on_site_count",
              "count_correction",
              "abnormal_mortality",
              "capture",
              "recapture",
              "mixed_sample",
              "field_finding"
            ]
          },
          "actor": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "minLength": 1},
          "reach_id": {"type": "string"},
          "payload": {"type": "object"},
          "immutable": {"const": true},
          "corrects": {"type": "string", "minLength": 1},
          "recorded_at": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "origin_assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "observation_id", "method", "assignment", "confidence", "analyst", "analysis_id"],
        "properties": {
          "id": {"type": "string"},
          "observation_id": {"type": "string"},
          "individual_id": {"type": "string"},
          "method": {"type": "string", "minLength": 1},
          "assignment": {"enum": ["hatchery", "wild_natural", "undifferentiated"]},
          "batch_id": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "posterior_hatchery": {"type": "number", "minimum": 0, "maximum": 1},
          "credible_interval": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "number"}
          },
          "tag_loss_assumed": {"type": "boolean"},
          "analyst": {"type": "string"},
          "analysis_id": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "analyses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "analysis_version", "status", "monitoring_protocol_version", "input_observation_ids", "adjustments", "produced_by"],
        "properties": {
          "id": {"type": "string"},
          "analysis_version": {"type": "integer", "minimum": 1},
          "status": {"enum": ["current", "superseded", "retracted"]},
          "monitoring_protocol_version": {"type": "string"},
          "supersedes": {"type": "string"},
          "protocol_change_reason": {"type": "string"},
          "input_observation_ids": {"type": "array", "items": {"type": "string"}},
          "adjustments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "detail"],
              "properties": {
                "type": {
                  "enum": [
                    "tag_shed",
                    "recapture_dedup",
                    "count_correction",
                    "abnormal_mortality",
                    "mixed_sample_probabilistic",
                    "detection_effort",
                    "other"
                  ]
                },
                "detail": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "formula", "inputs", "recomputable"],
              "properties": {
                "id": {"type": "string"},
                "name": {"type": "string"},
                "formula": {"type": "string"},
                "inputs": {"type": "array", "items": {"type": "string"}},
                "value": {},
                "recomputable": {"const": true}
              },
              "additionalProperties": false
            }
          },
          "produced_by": {"type": "string"},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "natural_spawning_evidence": {
      "type": "object",
      "required": ["signals", "evidence_boundary"],
      "properties": {
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "signal", "observation_ids", "strength"],
            "properties": {
              "id": {"type": "string"},
              "signal": {"type": "string"},
              "observation_ids": {"type": "array", "items": {"type": "string"}},
              "strength": {"enum": ["候选信号", "支持信号", "确证信号"]}
            },
            "additionalProperties": false
          }
        },
        "evidence_boundary": {
          "type": "object",
          "required": ["requires", "excludes", "threshold_confidence", "status"],
          "properties": {
            "requires": {"type": "array", "items": {"type": "string"}},
            "excludes": {"type": "array", "items": {"type": "string"}},
            "threshold_confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "status": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "year", "based_on_analysis", "adjustments", "natural_spawning_declaration", "decided_by"],
        "properties": {
          "id": {"type": "string"},
          "year": {"type": "integer", "minimum": 2000},
          "based_on_analysis": {"type": "string"},
          "adjustments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["dimension", "change"],
              "properties": {
                "dimension": {"enum": ["species", "quantity", "reach"]},
                "change": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "natural_spawning_declaration": {"type": "string"},
          "decided_by": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
